      "targets": [
        {
          "query": "from(bucket: \"bid_monitor\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"bid_failure\" and r._field == \"error\")\n  |> map(fn: (r) => ({\n      r with\n        run_name:\n          if r.run_type == \"health\" then \"Лендинг + мин ЛК (каждые 5 мин)\"\n          else if r.run_type == \"full\" then \"Лендинг + API autotests\"\n          else if r.run_type == \"lk_pytest\" then \"Боевой прогон ЛК (каждые 2 ч)\"\n          else if r.run_type == \"probe\" then \"HTTP probe (legacy)\"\n          else if exists r.run_label and r.run_label != \"\" then r.run_label\n          else \"Неизвестный прогон\"\n    }))\n  |> rename(columns: {_value: \"error\"})\n  |> keep(columns: [\"_time\", \"run_name\", \"run_type\", \"check\", \"label\", \"error\"])\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 500)",
          "refId": "A"
        }
      ],
      "title": "Ошибки прогонов",
      "description": "Список последних ошибок: когда произошла, какой из трёх мониторингов, что именно не сработало.",
      "transformations": [
