# InfluxDB 2.x
INFLUXDB_URL=http://127.0.0.1:8086
INFLUXDB_TOKEN=CHANGE_ME_GENERATE_ON_SERVER
INFLUXDB_ORG=bid
INFLUXDB_BUCKET=bid_monitor

# Telegram алерты
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PROXY=

# Мониторинг
MONITOR_RUN_UI=false
MONITOR_RUN_LK=false
MONITOR_HEADLESS=true
MONITOR_TIMEZONE=Europe/Moscow
MONITOR_HTTP_TIMEOUT=20
MONITOR_HTTP_CONNECT_TIMEOUT=10
MONITOR_PROBE_RETRIES=1
MONITOR_PROBE_RETRY_DELAY_SEC=30
MONITOR_ALERT_AFTER_FAILURES=2

# ЛК: авторизация + 2FA (только в monitor/.env, не коммитить!)
BID_USERNAME=
BID_PASSWORD=
BID_TOTP_SECRET=
BID_LK_EXPECTED_URL=https://lk.bid.gazprom-neft.ru/service-providers
BID_EXPECTED_COMPANY=ООО "А-Я ФРУКТ"
BID_EXPECTED_FIO=Никита Смирнов
BID_PROCESSOR_URL=https://processor.gazprom-neft.ru/
LK_AUTH_WAIT_SEC=12

# Prod-алерты
TELEGRAM_ALERT_ON_SUCCESS=false
TELEGRAM_ALERT_ON_RECOVERY=false
TELEGRAM_FULL_RUN_SUMMARY=true
TELEGRAM_ALERT_REPEAT_HOURS=4
TELEGRAM_VERBOSE=false
