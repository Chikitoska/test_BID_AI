# InfluxDB 2.x
INFLUXDB_URL=http://127.0.0.1:8086
INFLUXDB_TOKEN=CHANGE_ME_GENERATE_ON_SERVER
INFLUXDB_ORG=bid
INFLUXDB_BUCKET=bid_monitor

# Grafana → XLSX export (ветка feature/grafana-errors-xlsx-export; см. EXPORT-ERRORS-XLSX.md)
# Не коммитить реальные пароли. На VPS — только после явной отмашки.
EXPORT_BASIC_USER=
EXPORT_BASIC_PASSWORD=
EXPORT_BIND=127.0.0.1
EXPORT_PORT=8765

# Telegram на VPS не используем (api.telegram.org недоступен / риск блокировок).
# Токены — только в GitHub Secrets → workflow bid-telegram-relay.yml
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_PROXY на VPS не включать — похоже на обход блокировок (РКН)

# GitHub → Telegram relay (обязательно на VPS)
GITHUB_PAT=
GITHUB_REPO=Chikitoska/test_BID_AI

# Email-алерты с VPS (Yandex блокирует IP GitHub Actions — SMTP здесь, не в GitHub Secrets)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO="you@mail.ru, colleague@mail.ru"
# SMTP_FROM=
# SMTP_USE_TLS=true   # только для порта 587

# Мониторинг
MONITOR_RUN_UI=false
MONITOR_RUN_PYTEST=true
MONITOR_RUN_LK=false
MONITOR_HEADLESS=true
# User-Agent и uid для исключения мониторинга из SPA-отчётов (POST spa-back/events):
MONITOR_USER_AGENT="Mozilla/5.0 (compatible; BID-QA-Monitor/1.0) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
MONITOR_ANALYTICS_UID=b1d00000-0000-4000-a000-000000000001
# Путь к Chrome на VPS (если авто-поиск не сработал):
# CHROME_BINARY=/usr/bin/chromium
# CHROMEDRIVER_PATH=/usr/bin/chromedriver
# Блокировка Chrome между health и lk pytest (сек ожидания)
# CHROME_LOCK_WAIT_HEALTH_SEC=120
# CHROME_LOCK_WAIT_LK_PYTEST_SEC=900
# CHROME_START_RETRIES=3
MONITOR_TIMEZONE=Europe/Moscow
MONITOR_HTTP_TIMEOUT=25
MONITOR_HTTP_CONNECT_TIMEOUT=10
MONITOR_PROBE_RETRIES=1
MONITOR_PROBE_RETRY_DELAY_SEC=30
# Health: пауза перед повтором main_page при timeout/5xx
MONITOR_HEALTH_RETRY_DELAY_SEC=10
# ЛК: при 4xx/5xx повтор в том же прогоне (сек), затем алерт если снова плохо
MONITOR_HTTP_ERROR_RETRIES=1
MONITOR_HTTP_ERROR_RETRY_DELAY_SEC=90
# TG/email после N подряд FAIL health (2 ≈ ~10 мин при cron */5; для 4xx/5xx — сразу после retry)
MONITOR_ALERT_AFTER_FAILURES=2
# Боевой lk_pytest: TG/email только если FAIL похож на сеть/PROD (не на UI-флак автотеста)

# ЛК: health-монитор + pytest 2×/день — см. monitor/MONITOR-ARCH.md
BID_USERNAME=
BID_PASSWORD=
BID_TOTP_SECRET=
BID_LK_EXPECTED_URL=https://lk.bid.gazprom-neft.ru/service-providers
BID_EXPECTED_COMPANY='ООО "ВАША КОМПАНИЯ"'
BID_EXPECTED_FIO=Иван Иванов
BID_PROCESSOR_URL=https://processor.gazprom-neft.ru/
LK_AUTH_WAIT_SEC=12
LK_LOGIN_WAIT_SEC=30
LK_UI_WAIT_SEC=45
# Повтор чтения ФИО/компании в Processor при медленной шапке
LK_PROCESSOR_HEADER_ATTEMPTS=2
LK_PROCESSOR_HEADER_RETRY_DELAY_SEC=3

# Prod-алерты
TELEGRAM_ALERT_ON_SUCCESS=false
TELEGRAM_ALERT_ON_RECOVERY=false
TELEGRAM_FULL_RUN_SUMMARY=true
TELEGRAM_ALERT_REPEAT_HOURS=4
TELEGRAM_VERBOSE=false
